# Payment Gateway Template — Environment Variables
# Copy this file to `.env.local` and replace the {{PLACEHOLDER}} tokens.
# Never commit real secrets.

# Stellar network configuration
NEXT_PUBLIC_STELLAR_NETWORK={{STELLAR_NETWORK}}
NEXT_PUBLIC_STELLAR_HORIZON_URL={{STELLAR_HORIZON_URL}}
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE={{STELLAR_NETWORK_PASSPHRASE}}

# Payment gateway account
PAYMENT_GATEWAY_PUBLIC_KEY={{PAYMENT_GATEWAY_PUBLIC_KEY}}
PAYMENT_GATEWAY_SECRET_KEY={{PAYMENT_GATEWAY_SECRET_KEY}}

# Asset used for payments
NEXT_PUBLIC_PAYMENT_ASSET_CODE={{PAYMENT_ASSET_CODE}}
NEXT_PUBLIC_PAYMENT_ASSET_ISSUER={{PAYMENT_ASSET_ISSUER}}

# Branding
NEXT_PUBLIC_APP_NAME={{APP_NAME}}
NEXT_PUBLIC_APP_DESCRIPTION={{APP_DESCRIPTION}}
NEXT_PUBLIC_BRAND_COLOR={{BRAND_COLOR}}
